# Plantilla de secretos para el overlay local de Kubernetes (Kustomize secretGenerator).
#
# Uso: cp secrets.env.example secrets.env   (o directamente ./scripts/k8s-up.sh)
# secrets.env NO se versiona (ver .gitignore).
# Valores de desarrollo equivalentes a los de .env.example del Compose.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=secretodesk
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
K6_WRITER_USERNAME=escritor
K6_WRITER_PASSWORD=escritor-pass
K6_READER_USERNAME=lector
K6_READER_PASSWORD=lector-pass