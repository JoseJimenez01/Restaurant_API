# Plantilla de configuración del sistema completo (aplicación + PostgreSQL + Keycloak).
#
# Uso (reproducible):
#   cp .env.example .env     -> completar/ajustar valores reales
#   docker compose up -d     -> sistema arriba y saludable con un solo comando
#
# El archivo .env real está en .gitignore: NUNCA se versiona.

##### Puertos expuestos al host #####
API_PORT=8080
KC_PORT=8081

##### PostgreSQL #####
TAG_PG=16-alpine
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secretodesk
POSTGRES_DB=restaurantdb

##### Keycloak #####
TAG_KC=26.0
# Credenciales de administración del realm "master" (solo para bootstrap).
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
# Health y métricas (endpoint interno 9000).
KC_HEALTH_ENABLED=true
KC_METRICS_ENABLED=true
# Keycloak persiste en la misma PostgreSQL (por nombre de servicio), en su propia base.
KC_DB=postgres
KC_DB_URL=jdbc:postgresql://bd:5432/keycloakdb
# Dev local: caché local, HTTP habilitado, sin validación de hostname.
KC_CACHE=local
KC_HTTP_ENABLED=true
KC_HOSTNAME_STRICT=false

##### Aplicación #####
# Realm importado desde keycloak/realm-export.json (recrea client, rol y usuarios).
KEYCLOAK_REALM=restaurant
# Authority para descubrimiento OIDC POR NOMBRE DE SERVICIO (dentro de la red de Compose).
KEYCLOAK_AUTHORITY=http://auth:8080/realms/restaurant
# Issuer real que emite Keycloak cuando se le habla por localhost (dev); la app lo valida.
KEYCLOAK_VALID_ISSUER=http://localhost:8081/realms/restaurant
# Rol requerido para escribir (POST/PUT/DELETE).
KEYCLOAK_REQUIRED_ROLE=api-writer

##### Pruebas de integración (mismas URLs públicas que usa el evaluador) #####
TEST_API_BASE_URL=http://localhost:8080
TEST_KEYCLOAK_TOKEN_URL=http://localhost:8081/realms/restaurant/protocol/openid-connect/token
TEST_CLIENT_ID=restaurant-api
# Cliente público (Direct Access Grants): no requiere secret.
TEST_CLIENT_SECRET=
# Usuario CON el rol (puede escribir) y usuario SIN el rol (debe recibir 403).
TEST_USERNAME=escritor
TEST_PASSWORD=escritor-pass
TEST_USERNAME_NOROLE=lector
TEST_PASSWORD_NOROLE=lector-pass